# OS / editor cruft
.DS_Store
*.swp

# SDLC worktrees (created by /sdlc-task and /sdlc-block at runtime)
trees/

# Hook session logs (ephemeral)
.claude/logs/

# SDLC runtime resume breadcrumbs (regenerated every run — see D27/D28)
planning/*/sdlc/sdlc-state.json
planning/*/sdlc/sdlc-block-state.json
# NOTE: sdlc-flow-state.json and worklog.md are intentionally committed (D31 — authoritative state)
# They are NOT listed here and must remain tracked.
